# Puerto del servidor (uvicorn usa --port; esta variable la usan los scripts de arranque)
PORT=3001

# Cadena de conexión a MongoDB (misma base que el sistema NestJS original)
MONGODB_URI=mongodb://localhost:27017/sistema_solicitudes

# Secreto para firmar JWT. OBLIGATORIO, mínimo 32 caracteres. El servidor no arranca sin él.
# Si usa el MISMO valor que el backend NestJS, los tokens emitidos por uno sirven en el otro.
JWT_SECRET=changeme-min-32-characters-aleatorios

# Clave para cifrar las cédulas del padrón (menores de edad). OBLIGATORIA, 64 caracteres hex (32 bytes).
# DEBE ser la misma que usaba el backend NestJS, o las cédulas ya cifradas no podrán descifrarse.
# Generar una nueva: python -c "import secrets; print(secrets.token_hex(32))"
PADRON_ENCRYPTION_KEY=changeme-64-hex-characters-generar-con-el-comando-de-arriba

# Admin inicial (solo si no existe un admin con ese usuario; nunca modifica existentes).
# ADMIN_SEED_USERNAME=admin
# En producción (NODE_ENV=production) ADMIN_SEED_PASSWORD es obligatoria; en desarrollo se usa admin123.
# ADMIN_SEED_PASSWORD=

# Orígenes permitidos por CORS, separados por coma (por defecto http://localhost:5173 y :5174).
# CORS_ORIGINS=https://solicitudes.uets.edu.ec

# NODE_ENV=production   (se conserva el nombre del original; también desactiva /docs)
# TRUST_PROXY=true      (solo detrás de un proxy inverso de confianza: usa X-Forwarded-For para el rate limit)

# ── Sesión por cookie (panel SUPERADMIN / estudiantes) ──
# Cookies con Secure: true en producción con HTTPS (por defecto true si NODE_ENV=production).
# COOKIE_SECURE=true

# ── SUPERADMIN inicial (solo si no existe ninguno) ──
# En producción SUPERADMIN_SEED_PASSWORD es obligatoria. En desarrollo, sin ella, se crea con "superadmin123"
# y se obliga a cambiarla en el primer ingreso.
# SUPERADMIN_SEED_EMAIL=superadmin@uets.edu.ec
# SUPERADMIN_SEED_PASSWORD=

# Dominio del correo institucional para registro de estudiantes y altas de usuarios.
# INSTITUTIONAL_EMAIL_DOMAIN=uets.edu.ec

# Retención automática (días). También se cambia desde el panel → Configuración.
# USER_AUDIT_RETENTION_DAYS=730
# ERROR_LOG_RETENTION_DAYS=180

# ── Ingreso con Google (cuenta institucional) ──
# Client ID de OAuth 2.0 (tipo "Aplicación web") creado en Google Cloud Console. Es un valor público.
# El ingreso es SOLO con Google: sin esta variable nadie puede ingresar (salvo con ALLOW_PASSWORD_LOGIN=true).
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
#
# Ingreso con usuario y contraseña (apagado por defecto). Úsalo solo en tu equipo para las cuentas de
# prueba o como acceso de emergencia del SUPERADMIN; en producción déjalo en false.
# ALLOW_PASSWORD_LOGIN=false
# Con ALLOW_PASSWORD_LOGIN=true, permite además crear cuentas de estudiante con contraseña.
# ALLOW_PASSWORD_REGISTRATION=true
#
# Correos de estudiante: nombreapellido.est@INSTITUTIONAL_EMAIL_DOMAIN. Los correos sin este sufijo son de
# personal (docentes, administrativos): no se les crea cuenta; quedan en "Solicitudes de acceso" del SUPERADMIN.
# STUDENT_EMAIL_SUFFIX=.est

# El correo del representante es personal (cualquier correo válido). true = exigir el dominio institucional.
# REPRESENTATIVE_EMAIL_INSTITUTIONAL=false
